{
  "name": "AlgoDesign-Code",
  "displayName": "AlgoDesign: codice dai flowchart",
  "description": "Mostra in sola lettura il codice generato da un file .algo.",
  "version": "0.0.2",
  "publisher": "gilan65",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/gspe65/AlgoDesign-VSCode" },
  "icon": "icona.png",
  "engines": { "vscode": "^1.75.0" },
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [{ "id": "algo", "aliases": ["Flowchart AlgoDesign"], "extensions": [".algo"], "icon": { "light": "./icona.png", "dark": "./icona.png" } }],
    "commands": [{ "command": "algo.mostraCodice", "title": "Mostra il codice generato" }],
    "menus": {
      "commandPalette": [{ "command": "algo.mostraCodice", "when": "resourceExtname == .algo" }]
    },
    "configuration": {
      "title": "Codice dai flowchart",
      "properties": {
        "algo.linguaggio": {
          "type": "string",
          "enum": ["pseudocodice", "python", "c", "accademico", "typescript"],
          "default": "python",
          "description": "Il linguaggio del codice generato."
        },
        "algo.lingua": {
          "type": "string",
          "enum": ["it", "en"],
          "default": "it",
          "description": "La lingua dei nomi e dei commenti del codice generato."
        }
      }
    }
  },
  "scripts": {
    "nucleo": "bun strumenti/nucleo.ts",
    "costruisci": "bun strumenti/costruisci.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "@types/vscode": "1.75.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "7.0.2"
  }
}
