{
  "name": "AlgoDesign-Code",
  "displayName": "AlgoDesign: codice dai flowchart",
  "description": "Apre i file .algo in una pagina in sola lettura: il codice generato in C o in Python, con gli errori e gli avvisi del flowchart.",
  "version": "0.0.5",
  "publisher": "gilan65",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/gspe65/AlgoDesign-VSCode" },
  "icon": "icona.png",
  "engines": { "vscode": "^1.75.0" },
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [{ "id": "algo", "aliases": ["Flowchart AlgoDesign"], "extensions": [".algo"], "icon": { "light": "./icona.png", "dark": "./icona.png" } }],
    "customEditors": [{ "viewType": "algo.pagina", "displayName": "Flowchart di AlgoDesign", "selector": [{ "filenamePattern": "*.algo" }], "priority": "default" }],
    "commands": [{ "command": "algo.apriComeTesto", "title": "Apri come testo", "category": "AlgoDesign" }],
    "menus": {
      "commandPalette": [{ "command": "algo.apriComeTesto", "when": "activeCustomEditorId == algo.pagina" }]
    },
    "configuration": {
      "title": "Codice dai flowchart",
      "properties": {
        "algo.pseudocodifica": {
          "type": "boolean",
          "default": false,
          "description": "Mostra anche i linguaggi di pseudocodifica fra le scelte della pagina del flowchart (oggi Pseudocodice)."
        }
      }
    }
  },
  "scripts": {
    "nucleo": "bun strumenti/nucleo.ts",
    "costruisci": "bun strumenti/costruisci.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "@types/vscode": "1.75.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "7.0.2"
  }
}
